{
  "manifest_version": 3,
  "name": "Hermes Link Bridge",
  "version": "6.5.0",
  "description": "Right-click any link to send its URL to a local terminal command via the Hermes bridge server.",
  "permissions": ["contextMenus", "alarms", "notifications", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:<port>/", "http://localhost:<port>/"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-click.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
